{
  "name": "chess-repertoire-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run && node scripts/spec-copy.mjs --check",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "artifact": "node scripts/build-artifact.mjs",
    "e2e": "playwright test",
    "spec:constants": "vite-node scripts/spec-constants.mjs",
    "spec:copy": "node scripts/spec-copy.mjs",
    "spec:cases": "vite-node scripts/spec-cases.mjs",
    "spec:coverage": "vite-node scripts/spec-coverage.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "idb-keyval": "^6.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stockfish": "^10.0.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
